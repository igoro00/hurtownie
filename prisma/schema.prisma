// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id        Int    @id
  name      String
  contact   String
  country   String
  city      String
  region    String
  subregion String

  segment String

  industry String

  sales Sale[]
}

model Sale {
  id        Int      @id
  orderId   String
  orderDate DateTime

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  product String

  salesAmount Float
  quantity    Int
  discount    Float
  profit      Float
}
